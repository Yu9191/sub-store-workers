{
  "name": "sub-store-workers",
  "version": "1.1.0",
  "description": "Sub-Store on Cloudflare Workers",
  "private": true,
  "scripts": {
    "build": "node esbuild.js",
    "test": "mocha \"src/test/**/*.spec.js\" --require @babel/register --recursive",
    "dev": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && node -e \"const fs=require('fs');fs.mkdirSync('pages-dist',{recursive:true});fs.copyFileSync('dist/worker.js','pages-dist/_worker.js');fs.copyFileSync('dist/quickjs.wasm','pages-dist/quickjs.wasm')\" && wrangler pages deploy pages-dist --project-name sub-store --branch main",
    "rotate-secret": "powershell -ExecutionPolicy Bypass -File scripts/rotate-secret.ps1",
    "rotate-secret:sh": "bash scripts/rotate-secret.sh",
    "prepush": "node -e \"let f=require('fs'),t=f.readFileSync('wrangler.toml','utf8');if(!t.includes('你的KV命名空间ID')){console.error('\\x1b[31m请先清除 wrangler.toml 中的 KV ID!\\x1b[0m');process.exit(1)}\""
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@noble/hashes": "2.2.0",
    "age-encryption": "^0.3.0",
    "buffer": "^6.0.3",
    "dns-packet": "^5.6.1",
    "ip-address": "^10.3.1",
    "js-base64": "^3.7.2",
    "json5": "^2.2.3",
    "jsrsasign": "^11.1.0",
    "lodash": "^4.17.21",
    "ms": "^2.1.3",
    "nanoid": "^5.1.16",
    "peggy": "^2.0.1",
    "quickjs-emscripten": "^0.32.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.18.0",
    "@babel/preset-env": "^7.18.0",
    "@babel/register": "^7.17.7",
    "babel-plugin-module-resolver": "^5.0.3",
    "chai": "^4.3.6",
    "esbuild": "^0.19.8",
    "mocha": "^11.7.5",
    "wrangler": "^4.129.0"
  }
}
